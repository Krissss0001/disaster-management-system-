# Database connection URL (defaults to local SQLite database)
DATABASE_URL=sqlite:///./disaster_response.db

# Emergency Alert & Dispatch Service Configuration
# Set to 'true' to enable emergency alerts; 'mock' enables simulated calling/SMS logs without needing paid accounts
ALERT_MODE=mock

# Twilio Configuration (Optional - for real SMS / voice calling)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMERGENCY_DISPATCH_PHONE=+15551234567

# Optional Webhook URL (e.g. Slack / Discord / PagerDuty / Hospital Webhook)
ALERT_WEBHOOK_URL=
